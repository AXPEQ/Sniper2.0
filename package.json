{
  "name": "sniper2.0",
  "version": "0.1.0",
  "private": true,
  "description": "Solana pump.fun meme coin sniper bot: new token detection, safety filters, auto-buy and TP/SL auto-sell",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "report": "tsx src/report.ts",
    "update": "sh scripts/update.sh"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dotenv": "^16.6.1",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
