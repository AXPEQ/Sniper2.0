# ===== Подключение =====
# Публичный RPC подходит только для пробы: он режет запросы (429) и медленный.
# Для реальной работы возьмите приватный RPC (Helius, QuickNode, Triton, Shyft и т.п.).
RPC_URL=https://api.mainnet-beta.solana.com
# WebSocket-адрес, если он не выводится из RPC_URL автоматически (http→ws)
WS_URL=
# processed — быстрее всего узнаём о новых токенах; confirmed — надёжнее
LISTEN_COMMITMENT=processed

# ===== Режим =====
# true — симуляция (бумажная торговля), false — РЕАЛЬНЫЕ сделки
DRY_RUN=true
# Приватный ключ в base58 (нужен только для DRY_RUN=false). Используйте ОТДЕЛЬНЫЙ кошелёк!
PRIVATE_KEY=
LOG_LEVEL=info
JOURNAL_PATH=data/trades.jsonl

# ===== Покупка =====
BUY_AMOUNT_SOL=0.05
BUY_SLIPPAGE_PCT=25
SELL_SLIPPAGE_PCT=30
PRIORITY_FEE_SOL=0.0005
# Пауза перед проверками/покупкой (мс). 0 — максимально быстро; 2000–5000 — фильтры по холдерам осмысленнее
BUY_DELAY_MS=0
MAX_OPEN_POSITIONS=3
# Общий бюджет на сессию: после него новые покупки останавливаются (0 — без лимита)
MAX_TOTAL_SPENT_SOL=0.5
# Сколько SOL всегда оставлять на кошельке (на комиссии продаж)
MIN_SOL_RESERVE=0.02
MAX_CONCURRENT_CHECKS=5
# Симулировать каждую транзакцию перед отправкой (защита от неожиданных списаний, +100–300мс)
SIMULATE_BEFORE_SEND=true

# ===== Выход из позиции =====
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=30
# Трейлинг-стоп: продать при откате на N% от пика (0 — выключен)
TRAILING_STOP_PCT=0
# Трейлинг включается только после роста на N%
TRAILING_ACTIVATION_PCT=30
# Принудительно продать через N секунд (0 — без ограничения)
MAX_HOLD_SECONDS=300
# Резервный опрос цены (основные обновления приходят по WebSocket)
PRICE_POLL_MS=2000
# Продавать открытые позиции при остановке бота (Ctrl+C)
SELL_ON_EXIT=false

# ===== Фильтры =====
# Пропускать mayhem-токены (с ними торгует AI-агент pump.fun, кривая нестандартная)
SKIP_MAYHEM=true
# Требовать Twitter/Telegram/сайт в метаданных
REQUIRE_SOCIALS=true
METADATA_TIMEOUT_MS=2500
# IPFS-шлюзы через запятую (по умолчанию pump.mypinata.cloud и ipfs.filebase.io)
IPFS_GATEWAYS=
# Стоп-слова в имени/тикере через запятую (без учёта регистра, ищутся как подстрока)
NAME_BLACKLIST=scam,honeypot
# Если задано — покупать только токены с этими словами
NAME_WHITELIST=
# Адреса создателей, которых всегда пропускать
CREATOR_BLACKLIST=
# Пропускать копии имён/тикеров, уже виденных за последние N минут
SKIP_DUPLICATE_NAMES=true
DUPLICATE_WINDOW_MINUTES=60
# Капитализация в SOL на момент проверки (старт стандартной кривой ≈ 28 SOL)
MIN_MARKET_CAP_SOL=20
MAX_MARKET_CAP_SOL=60
# Макс. доля разработчика (подписант + creator), % от supply (0 — не проверять)
MAX_DEV_HOLDING_PCT=10
# Макс. доля топ-10 холдеров без bonding curve, % (0 — не проверять; тяжёлый RPC-запрос)
MAX_TOP10_HOLDING_PCT=0

# ===== Симуляция =====
# Комиссия на сделку в симуляции: pump.fun 1.25% + PumpPortal 0.5%
SIM_FEE_PCT=1.75
