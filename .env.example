# ===== Подключение =====
# Ключ Helius (https://helius.dev) — для обычных запросов (1 кредит за запрос; в строгом режиме их единицы в час).
HELIUS_API_KEY=
# Или любой другой приватный RPC (имеет приоритет над HELIUS_API_KEY)
RPC_URL=
# WebSocket для подписок. По умолчанию — бесплатный публичный узел Solana.
# Не ставьте сюда Helius на бесплатном плане: Helius берёт 2 кредита за каждые 0.1 МБ потока.
STREAM_WS_URL=
# processed — быстрее всего узнаём о новых токенах; confirmed — надёжнее
LISTEN_COMMITMENT=processed

# ===== Режим =====
# true — бумажная торговля (виртуальные деньги, реальные цены), false — РЕАЛЬНЫЕ сделки
DRY_RUN=true
# Приватный ключ в base58 (нужен только для DRY_RUN=false). Используйте ОТДЕЛЬНЫЙ кошелёк!
PRIVATE_KEY=
LOG_LEVEL=info
# Печатать каждый отсеянный токен с причиной (по умолчанию — только сводка раз в минуту)
SHOW_REJECTED=false
JOURNAL_PATH=data/trades.jsonl

# ===== Бумажная торговля (DRY_RUN=true) =====
# Стартовый виртуальный баланс. Баланс сохраняется между запусками в PAPER_STATE_PATH
PAPER_BALANCE_SOL=5
PAPER_STATE_PATH=data/paper-wallet.json
# true — начать с чистого виртуального кошелька
PAPER_RESET=false
# Задержка «доставки» транзакции: цена исполнения берётся с кривой после неё
SIM_LATENCY_MS=800
# Рента токен-аккаунта, которая остаётся заблокированной после покупки
SIM_ACCOUNT_RENT_SOL=0.0021
# Комиссия на сделку: pump.fun 1.25% + PumpPortal 0.5%
SIM_FEE_PCT=1.75

# ===== Покупка =====
BUY_AMOUNT_SOL=0.05
BUY_SLIPPAGE_PCT=25
SELL_SLIPPAGE_PCT=30
PRIORITY_FEE_SOL=0.0005
MAX_OPEN_POSITIONS=3
# Общий бюджет на сессию для РЕАЛЬНЫХ денег: после него покупки останавливаются (0 — без лимита).
# В бумажном режиме не действует — там ограничивает виртуальный баланс.
MAX_TOTAL_SPENT_SOL=0.5
# Сколько SOL всегда оставлять на кошельке (на комиссии продаж)
MIN_SOL_RESERVE=0.02
MAX_CONCURRENT_CHECKS=10
# Симулировать каждую транзакцию перед отправкой (защита от неожиданных списаний, +100–300мс)
SIMULATE_BEFORE_SEND=true

# ===== Выход из позиции =====
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=30
# Трейлинг-стоп: продать при откате на N% от пика (0 — выключен)
TRAILING_STOP_PCT=0
# Трейлинг включается только после роста на N%
TRAILING_ACTIVATION_PCT=30
# Принудительно продать через N секунд (0 — без ограничения)
MAX_HOLD_SECONDS=300
# Резервный опрос цены через RPC (основные обновления приходят по WebSocket бесплатно)
PRICE_POLL_MS=30000
# Продавать открытые позиции при остановке бота (Ctrl+C)
SELL_ON_EXIT=false

# ===== Фильтры =====
# Пресет: strict (строгий, по умолчанию) или normal (быстрый вход сразу после создания).
# Пресет задаёт значения ниже; любое можно переопределить, раскомментировав строку.
FILTER_PRESET=strict

# Пропускать mayhem-токены (с ними торгует AI-агент pump.fun, кривая нестандартная)
SKIP_MAYHEM=true
# Требовать хотя бы одну соцсеть (Twitter/Telegram/сайт) в метаданных
REQUIRE_SOCIALS=true
METADATA_TIMEOUT_MS=2500
# IPFS-шлюзы через запятую (по умолчанию pump.mypinata.cloud и ipfs.filebase.io)
IPFS_GATEWAYS=
# Стоп-слова в имени/тикере через запятую (без учёта регистра, ищутся как подстрока)
NAME_BLACKLIST=scam,honeypot
# Если задано — покупать только токены с этими словами
NAME_WHITELIST=
# Адреса создателей, которых всегда пропускать
CREATOR_BLACKLIST=
# Проверять mint через RPC (1 кредит на финалиста). Для pump.fun избыточно: бот и так проверяет,
# что событие выпустила программа pump.fun, а она всегда отзывает права mint/freeze
CHECK_MINT=false
# Пропускать токены с именем, уже виденным за последние N минут (копии; совпадение тикера не считается)
SKIP_DUPLICATE_NAMES=true
DUPLICATE_WINDOW_MINUTES=60

# --- Параметры пресета (значения: strict / normal) ---
# Окно наблюдения после создания токена, мс: бот смотрит на первые сделки и только потом решает
# BUY_DELAY_MS=6000                 # normal: 0
# Обязательна ссылка на X/Twitter и картинка
# REQUIRE_TWITTER=true              # normal: false
# REQUIRE_IMAGE=true                # normal: false
# Капитализация в SOL на момент проверки (старт стандартной кривой ≈ 28 SOL)
# MIN_MARKET_CAP_SOL=25             # normal: 20
# MAX_MARKET_CAP_SOL=80             # normal: 60
# Макс. доля разработчика (подписант + creator), % supply (0 — не проверять)
# MAX_DEV_HOLDING_PCT=5             # normal: 10
# Макс. доля топ-10 холдеров без bonding curve, % (0 — не проверять)
# MAX_TOP10_HOLDING_PCT=30          # normal: 0
# Мин. баланс SOL у разработчика (пустые одноразовые кошельки — частый признак скама)
# MIN_DEV_SOL_BALANCE=0.1           # normal: 0
# --- Активность за окно наблюдения (сделки разработчика не учитываются) ---
# Мин. число уникальных покупателей
# MIN_UNIQUE_BUYERS=8               # normal: 0
# Мин. объём покупок, SOL
# MIN_BUY_VOLUME_SOL=2              # normal: 0
# Макс. объём продаж относительно покупок (0.5 = 50%; 0 — не проверять)
# MAX_SELL_RATIO=0.6                # normal: 0
# Отказ, если разработчик продал больше N% купленного (частичная фиксация прибыли — норма; 100 — не проверять)
# MAX_DEV_SOLD_PCT=50               # normal: 100
# Макс. доля одного кошелька в объёме покупок, % (0 — не проверять)
# MAX_SINGLE_BUYER_PCT=35           # normal: 0
# Макс. покупателей в одном блоке с созданием — бандл/инсайдеры (-1 — не проверять)
# MAX_BUNDLED_BUYERS=3              # normal: -1
# Допустимое изменение цены за окно относительно цены после создания, %
# MIN_PRICE_CHANGE_PCT=0            # normal: -100
# MAX_PRICE_CHANGE_PCT=150          # normal: 0 (не проверять)
